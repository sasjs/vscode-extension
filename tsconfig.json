{
  "compilerOptions": {
    "module": "node16",
    "moduleResolution": "node16",
    "target": "es6",
    "outDir": "out",
    "strictPropertyInitialization": false,
    "allowSyntheticDefaultImports": true,
    "lib": ["ES2018", "DOM", "ES2019.String"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", ".vscode-test", "build.ts", "**/*.spec.ts"]
}
